2965. Find Missing and Repeated Values
class Solution:
    def findMissingAndRepeatedValues(self, grid):
        seen = set()
        repeated = 0

        n = len(grid)
        total = n * n

        for row in grid:
            for num in row:
                if num in seen:
                    repeated = num
                seen.add(num)

        for num in range(1, total + 1):
            if num not in seen:
                missing = num
                break

        return [repeated, missing]






287. Find the Duplicate Number
class Solution:
    def findDuplicate(self, nums):
        slow = nums[0]
        fast = nums[0]

        while True:
            slow = nums[slow]
            fast = nums[nums[fast]]

            if slow == fast:
                break

        slow = nums[0]

        while slow != fast:
            slow = nums[slow]
            fast = nums[fast]

        return slow




50. Pow(x, n)
class Solution:
    def myPow(self, x,n):
        if n <0:
            x = 1/x
            n = -n
        ans = 1

        while n:
            if n % 2:
                ans *= x
            x *= x
            n //= 2
        return ans 




