2965. Find Missing and Repeated Values(Leetcode):
class Solution:
    def findMissingAndRepeatedValues(self, grid):
        seen = set()
        repeated = 0

        n = len(grid)
        total = n * n

        for row in grid:
            for num in row:
                if num in seen:
                    repeated = num
                seen.add(num)

        for num in range(1, total + 1):
            if num not in seen:
                missing = num
                break

        return [repeated, missing]



