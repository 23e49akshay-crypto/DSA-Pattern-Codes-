2965. Find Missing and Repeated Values(Leetcode):
class Solution:
    def findMissingAndRepeatedValues(self, grid):
        seen = set()
        repeated = 0

        n = len(grid)
        total = n * n

        for row in grid:
            for num in row:
                if num in seen:
                    repeated = num
                seen.add(num)

        for num in range(1, total + 1):
            if num not in seen:
                missing = num
                break

        return [repeated, missing]



287. Find the Duplicate Number(Leetcode):
class Solution {
public:
    int findDuplicate(vector<int>& arr) {
        int slow= arr[0], fast =arr[0];

        do {
            slow = arr[slow];
            fast = arr[arr[fast]];

        }while(slow != fast);

        slow = arr[0];

        while(slow!= fast){
            slow = arr[slow];
            fast= arr[fast];

        }
        return slow;
        
    }
};







88. Merge Sorted Array(Leetcode):
class Solution {
public:
    void merge(vector<int>& A, int m, vector<int>&  B ,int n) {
        int  idx = m+n-1,i=m-1,j=n-1;

        while (i>=0 && j>=0){
            if(A[i]>=B[j]){
                A[idx--]= A[i--];

            }else{
                A[idx--]=B[j--];
            }
        }
        while(j>=0){
            A[idx--]=B[j--];
        }
        
    }
};




31. Next Permutation(Leetcode):
class Solution {
public:
    void nextPermutation(vector<int>& A) {
        int n = A.size();
        int pivot = -1;

        // 1. Find pivot
        for (int i = n - 2; i >= 0; i--) {
            if (A[i] < A[i + 1]) {
                pivot = i;
                break;
            }
        }

        // 2. If no pivot, array is in descending order
        if (pivot == -1) {
            reverse(A.begin(), A.end());
            return;
        }

        // 3. Find the next greater element and swap
        for (int i = n - 1; i > pivot; i--) {
            if (A[i] > A[pivot]) {
                swap(A[i], A[pivot]);
                break;
            }
        }

        // 4. Reverse the suffix
        reverse(A.begin() + pivot + 1, A.end());
    }
};




540. Single Element in a Sorted Array(Leetcode):
class Solution:
    def singleNonDuplicate(self, nums):
        left = 0
        right = len(nums) - 1

        while left < right:
            mid = (left + right) // 2

            if mid % 2 == 1:
                mid -= 1

            if nums[mid] == nums[mid + 1]:
                left = mid + 2
            else:
                right = mid

        return nums[left]


